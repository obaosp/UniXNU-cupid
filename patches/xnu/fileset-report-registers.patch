--- a/osfmk/kern/debug.c
+++ b/osfmk/kern/debug.c
@@ -2578,14 +2578,60 @@
 }
 #endif /* __arm64__ */
 
+void unixnu_fileset_unmapped_report(uint64_t *registers) __attribute__((used, noreturn));
+
 /*
  * Target of original kext calls into kernel functions this kernel does not have (fileset emission
- * redirects them here). The return address is the call site in the original component.
+ * redirects them here). A caller may reach this symbol through a tail branch, so x30 can hold a
+ * stale data pointer instead of the call site. Save the raw registers and let the report name the
+ * import stub (x16) and the PAC modifier (x17) as well as the raw and stripped x30.
  */
-__attribute__((noinline, noreturn, used))
+__attribute__((naked, noreturn, used))
+void
+unixnu_fileset_unmapped(void)
+{
+	__asm__ volatile(
+	    "sub sp, sp, #0x60\n\t"
+	    "stp x0, x1, [sp, #0x00]\n\t"
+	    "stp x8, x16, [sp, #0x10]\n\t"
+	    "stp x17, x30, [sp, #0x20]\n\t"
+	    "mov x0, sp\n\t"
+	    "bl _unixnu_fileset_unmapped_report\n\t"
+	    "brk #0\n\t");
+}
+
+__attribute__((used, noreturn))
 void
-unixnu_fileset_unmapped(uint64_t arg0, uint64_t arg1)
+unixnu_fileset_unmapped_report(uint64_t *r)
+{
+	panic("fileset: original component called an unmapped kernel function from raw %p stripped %p (x0 0x%llx x1 0x%llx x8 0x%llx x16 0x%llx x17 0x%llx)",
+	    (void *)r[5], __builtin_ptrauth_strip((void *)r[5], 0), r[0], r[1], r[2], r[3], r[4]);
+}
+
+/*
+ * AppleM2ScalerCSCDriver from the 13432 kernel calls a clock/state reader that the 12377 source
+ * does not have. The prelink's native data placement overwrites the globals the original reader
+ * used, so return the first state instead of calling the unmapped stub. The caller uses the low
+ * three bits as a state index and retries; zero is the first state.
+ */
+__attribute__((used))
+uint32_t
+unixnu_apple_m2_clock_state(void)
+{
+	return 0;
+}
+
+/*
+ * AppleM2ScalerCSCDriver's 13432 property helper zeroes a caller buffer, looks up a string
+ * property by key and copies it. The 12377 kernel has no equivalent. Zero a valid buffer and
+ * report "absent" so the driver takes its no-property path instead of the unmapped stub.
+ */
+__attribute__((used))
+void *
+unixnu_apple_m2_property(void *key __unused, void *buffer, uint32_t size)
 {
-	panic("fileset: original component called an unmapped kernel function from %p (x0 0x%llx x1 0x%llx)",
-	    __builtin_ptrauth_strip(__builtin_return_address(0), 0), arg0, arg1);
+	if (buffer != NULL && size != 0) {
+		bzero(buffer, size);
+	}
+	return NULL;
 }
