# Stage 0 (iOS 27 bring-up): arm64e kernel, owner storage chain later.
# Display and GPU stay off until their iPhone17,2 / Adreno 730 ABI inputs exist:
# CONFIG_XNU_NATIVE_LEGACY_DISPLAY needs a 24A446 d94ap display record and
# CONFIG_XNU_NATIVE_ADRENO is the Adreno 740 driver, not the 730 this SoC has.
CONFIG_XNU_BUILD_ARCHIVES=y
CONFIG_XNU_CRYPTO_BOOTSTRAP="source"
CONFIG_XNU_DT_PANIC_REGION=y
CONFIG_XNU_ARMVIRT_PLATFORM=n
CONFIG_XNU_KERNEL_CHAINED_FIXUPS=y
# SM8450 UFS uses the waipio-adapted ShengUfs tree below.
# CONFIG_XNU_NATIVE_ADRENO is not set
# CONFIG_XNU_NATIVE_LEGACY_DISPLAY is not set
# SM8450 UFS source storage: ShengUfs tree adapted to waipio; the cupid dummy
# policy directory satisfies the build checks and the driver forces
# NATIVE_VERIFIED_BLOCK=0 for the first root bring-up.
# The ShengUfs component archive (build/sheng-ufs/libShengUfs.a) is force-loaded
# by build-xnu-4k-baseline.sh when CONFIG_XNU_NATIVE_UFS=y; do not add it to
# CONFIG_XNU_EXTRA_LD_ARCHIVES or the same objects link twice.
CONFIG_XNU_NATIVE_UFS=y
CONFIG_XNU_SOURCE_STORAGE=y
